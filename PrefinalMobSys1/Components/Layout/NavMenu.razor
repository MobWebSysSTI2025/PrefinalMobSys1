@using PrefinalMobSys1.Data
@inject NavigationManager Nav
@inject AppShellContext AppShell
<style>
</style>
<nav class="mobile-nav bg-light" onclick="hideMenu()">
    @if (AppShell.IsUserLoggedIn)
    {
        if (AppShell.CurrentUser!=null)
        {
            <div class="userpane text-secondary bg-info display-6 p-3">
				<i class="fa fa-user-circle"></i>&nbsp;@AppShell.CurrentUser.FirstName @AppShell.CurrentUser.LastName
            </div>
        }

		<div class="text-dark">
			<div class="p-3">
				<a class="nav-link" href="">
					<i class="fa fa-calendar-check text-primary"></i>&nbsp;Todo List
				</a>
			</div>
			<span class="border-bottom"></span>
			<div class ="p-3">
				<a class="nav-link" href="kanbanboard">
					<i class="fa fa-table text-secondary"></i>&nbsp;Kanban Board
				</a>
			</div>
		</div>
    }
	<hr />
    @if (AppShell.IsUserLoggedIn)
    {
		<div class="text-dark">
            <!--Admin Pages Here-->
			<div class="p-3">
                <a class="nav-link" href="users">
                    <i class="fa fa-users text-warning"></i>&nbsp;Users
                </a>
            </div>
			<span class="border-bottom"></span>
			<div class="p-3">
				<a class="nav-link" href="javascript:void(0)" @onclick="Logout">
					<i class="fas fa-sign-out-alt text-danger"></i>&nbsp;Logout
				</a>
			</div>
        </div>
    }
    else
    {
		<div class="class="text-black"">
            <div class="p-3">
                <a class="nav-link" href="register">
                    <i class="fa fa-list text-warning"></i>&nbsp;Register
                </a>
            </div>
			<span class="border-bottom"></span>
            <div class="p-3">
                <a class="nav-link" href="login">
                    <i class="fa fa-sign-in-alt text-info"></i>&nbsp;Login
                </a>
            </div>
        </div>
    }
</nav>

@code {
    protected override void OnInitialized()
    {
        AppShell.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppShell.OnChange -= StateHasChanged;
    }

    public async void Logout()
    {
        AppShell.ClearSessionUser();
        AppShell.CurrentUser = null;
        AppShell.IsUserLoggedIn = false;
        await InvokeAsync(StateHasChanged);
        Nav.NavigateTo($"/login?returnto=home");
    }
}