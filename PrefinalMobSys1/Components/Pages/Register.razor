@page "/register"

@if (!string.IsNullOrWhiteSpace(StatusMessage))
{
    <div class="alert alert-@Status">
        <i class="fa fa-info-circle"></i>&nbsp;
        @StatusMessage
    </div>
}
<div class="card shadow-sm my-4">
	<div class="card-header bg-secondary">
		<h3>Register</h3>
	</div>
	<div class="card-body bg-white text-primary">
		<div class="mb-3">
			<label class="form-label">Username:</label>
			<input class="form-control" type="text" @bind="Model.Username" />
		</div>
		<div class="mb-3">
			<label class="form-label">Password:</label>
			<input class="form-control" type="password" @bind="Model.Password" />
		</div>
		<div class="mb-3">
			<label class="form-label">First Name:</label>
			<input class="form-control" type="text" @bind="Model.FirstName" />
		</div>
		<div class="mb-3">
			<label class="form-label">Last Name:</label>
			<input class="form-control" type="text" @bind="Model.LastName" />
		</div>
		<div class="mb-3">
			<label class="form-label">Mobile:</label>
			<input class="form-control" type="text" @bind="Model.MobileNumber" />
		</div>
		<div class="mb-3">
			<label class="form-label">Address:</label>
			<textarea class="form-control" @bind="Model.Address"></textarea>
		</div>
		<div class="card-footer mb-3 text-white">
			<button class="btn btn-success w-100" @onclick="RegisterUser">
				Save
			</button>
		</div>
	</div>
</div>
