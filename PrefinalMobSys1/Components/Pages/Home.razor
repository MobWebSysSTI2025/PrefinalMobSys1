@page "/"
@using PrefinalMobSys1.Components.Shared
<SectionContent SectionName="page-buttons">
    <div id="searchBox" class="input-group header-search" style="display:none;">
        <span class="input-group-text text-warning"><i class="fa fa-search"></i></span>
        <input id="txtSearch" type="text" class="form-control" placeholder="Search" value="@Model.Search" @onchange="SearchTerm" />
        <span class="input-group-text" onclick="hideSearchBox()"><i class="fa fa-times"></i></span>
    </div>
    <span id="controlBox">
        @* <CartButton /> *@
        <button class="btn text-secondary mr-2" onclick="showSearchBox()">
            <i class="fa fa-search"></i>
        </button>
    </span>    
</SectionContent>


<h1 class="display-4">To-do List</h1>

<section>
    <div class="smallmenulist">
		<button class="btn text-secondary rounded-5" data-bs-toggle="modal" data-bs-target="#addTodoModal">
			<i class="fa fa-plus"></i>
		</button>
    </div>
</section>


<!-- modal -->
<div class="modal fade" id="addTodoModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content">
			<!-- modal header -->
			<div class="modal-header">
				<h5 class="modal-title">Add Todo</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<!-- modal body -->
			<div class="modal-body">
				<input type="text" id="todoTitle" class="form-control" placeholder="To-do Title"/>
				<input type="text" id="todoNotes" class="form-control" placeholder="To-do Notes" />
			</div>

			<!-- modal footer -->
			<div class="modal-footer">
				<button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
				<button type="button" class="btn btn-success">Add</button>
			</div>
		</div>
	</div>
</div>


<script src="js/jquery.cycle2.js"></script>
<script>
    function showSearchBox(){
        $('#searchBox').show();    
        $('#controlBox').hide();
    }
    function hideSearchBox(){
        $('#searchBox').hide();
        $('#controlBox').show();
    }
</script>