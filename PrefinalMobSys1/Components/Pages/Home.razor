@page "/"
@using PrefinalMobSys1.Components.Shared
<SectionContent SectionName="page-buttons">
	<div id="searchBox" class="input-group header-search" style="display:none;">
		<span class="input-group-text text-warning"><i class="fa fa-search"></i></span>
		<input id="txtSearch" type="text" class="form-control" placeholder="Search" value="@Model.Search" @onchange="SearchTerm" />
		<span class="input-group-text" onclick="hideSearchBox()"><i class="fa fa-times"></i></span>
	</div>
	<span id="controlBox">
		@* <CartButton /> *@
		<button class="btn text-secondary mr-2" onclick="showSearchBox()">
			<i class="fa fa-search"></i>
		</button>
	</span>    
</SectionContent>



@if (AppShell.IsUserLoggedIn)
{
	<h1 class="display-4">To-do List</h1>

	<section>
		<div class="smallmenulist">
			<button class="btn text-white bg-secondary floating-btn rounded-5" data-bs-toggle="modal" data-bs-target="#addTodoModal">
				<i class="fa fa-plus"></i>
			</button>
		</div>
	</section>


	<!-- modal -->
	<div class="modal fade" id="addTodoModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content">
				<!-- modal header -->
				<div class="modal-header">
					<h5 class="modal-title">Add Todo</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<!-- modal body -->
				<div class="modal-body">
					<input type="text" id="todoTitle" class="form-control my-2" placeholder="To-do Title" />
					<textarea id="todoNotes" class="form-control my-2" placeholder="To-do Notes" />
				</div>

				<!-- modal footer -->
				<div class="modal-footer">
					<button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
					<button type="button" class="btn btn-success">Add</button>
				</div>
			</div>
		</div>
	</div>

	<div class="btn-group" role="group" aria-label="Basic radio toggle button group">
	  <input type="radio" class="btn-check" name="btnradio" id="btnradio1" autocomplete="off" checked="">
	  <label class="btn btn-outline-primary" for="btnradio1"><i class="fa fa-th"></i> Grid View</label>
	  <input type="radio" class="btn-check" name="btnradio" id="btnradio2" autocomplete="off" checked="">
	  <label class="btn btn-outline-secondary" for="btnradio2"><i class="fa fa-list"></i> List View</label> 
	</div>

	<!-- List view -->
	<div>
		<div class="card shadow-sm my-4">
			<div class="card-header bg-primary text-white p-2">
				<input type="checkbox" class="form-check-input me-2" />
				<span>Buy groceries</span>
			</div>
			<div class="card-body">
				<p class="card-text">Remember to buy milk, eggs, and bread.</p>
			</div>
			<div class="card-footer">
				<div class="d-flex justify-content-between">
					<small class="text-muted">Due: Tomorrow</small>
					<button class="btn btn-secondary btn-sm">Edit</button>
				</div>
			</div>
		</div>
		<div class="card shadow-sm my-4">
			<div class="card-header bg-primary text-white p-2">
				<input type="checkbox" class="form-check-input me-2" />
				<span>Finish project</span>
				<span>
					<i class="fa-ellipsis-v"></i>
				</span>
			</div>
			<div class="card-body">
				<p class="card-text">Complete the final report.</p>
			</div>
			<div class="card-footer">
				<div class="d-flex justify-content-between">
					<small class="text-muted">Due: Tomorrow</small>
					<button class="btn btn-secondary btn-sm">Edit</button>
				</div>
			</div>
		</div>
	</div>


	<!-- Grid view -->
	<div class="row">
		<div class="col-4 mb-4">
			<div class="card shadow-sm h-100">
				<div class="card-header bg-primary text-white p-2">
					<input type="checkbox" class="form-check-input me-2" />
					<span>Buy groceries</span>
				</div>
				<div class="card-body">
					<p class="card-text">Remember to buy milk, eggs, and bread.</p>
				</div>
				<div class="card-footer">
				<div class="d-flex justify-content-between">
					<small class="text-muted">Due: Tomorrow</small>
					<button class="btn btn-secondary btn-sm">Edit</button>
				</div>
			</div>
			</div>
		</div>
		<div class="col-4 mb-4">
			<div class="card shadow-sm h-100">
				<div class="card-header bg-primary text-white p-2">
					<input type="checkbox" class="form-check-input me-2" />
					<span>Finish project</span>
				</div>
				<div class="card-body">
					<p class="card-text">Complete the final report.</p>
				</div>
				<div class="card-footer">
				<div class="d-flex justify-content-between">
					<small class="text-muted">Due: Tomorrow</small>
					<button class="btn btn-secondary btn-sm">Edit</button>
				</div>
			</div>
			</div>
		</div>
		<div class="col-4 mb-4">
			<div class="card shadow-sm h-100">
				<div class="card-header bg-primary text-white p-2">
					<input type="checkbox" class="form-check-input me-2" />
					<span>Finish project</span>
				</div>
				<div class="card-body">
					<p class="card-text">Complete the final report.</p>
				</div>
				<div class="card-footer">
				<div class="d-flex justify-content-between">
					<small class="text-muted">Due: Tomorrow</small>
					<button class="btn btn-secondary btn-sm">Edit</button>
				</div>
			</div>
			</div>
		</div>
	</div>
}
else
{
		<!-- Default homepage design for guests -->
		<div class="text-center mt-5">
			<h1 class="display-3">Welcome to the To-do App!</h1>
			<p class="lead">Please register or log in to access your to-do list and features.</p>
		</div>
}

