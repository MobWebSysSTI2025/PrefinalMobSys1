@page "/"
@using PrefinalMobSys1.Data
@inject DatabaseContext Db

<h1>My Todo List</h1>

<div class="add-task">
    <input @bind="newTaskText" @bind:event="oninput" placeholder="Add a new task..." type="text" />
    <input type="date" @bind="newTaskDate" />
    <button @onclick="AddTask">+</button>
    <button @onclick="ClearAllTasks" style="background-color: red;">Clear All</button>
    <button @onclick="ToggleView">
        @if (isGridView)
        {
            <span>List View</span>
        }
        else
        {
            <span>Grid View</span>
        }
    </button>
</div>

@if (!isGridView)
{
    <table class="task-table">
        <thead>
            <tr>
                <th style="width: 60px;">Done</th>
                <th style="text-align: left;">Task</th>
                <th style="text-align: left; width: 150px;">Due Date</th>
                <th style="width: 50px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var task in tasks)
            {
                <tr>
                    <td style="text-align: center;">
                        <input type="checkbox" checked="@task.IsCompleted" @onchange="@(() => ToggleComplete(task))" />
                    </td>
                    <td>
                        @if (editTask == task)
                        {
                            <input @bind="editTaskText" style="width: 90%;" />
                        }
                        else
                        {
                            <label class="@GetTaskClass(task)" @onclick="@(() => ToggleComplete(task))" style="cursor: pointer;">@task.Text</label>
                        }
                    </td>
                    <td>
                        @if (editTask == task)
                        {
                            <input type="date" @bind="editTaskDate" />
                        }
                        else
                        {
                            @task.DueDate.ToString("yyyy-MM-dd")
                        }
                    </td>
                    <td>
                        @if (editTask == task)
                        {
                            <button @onclick="() => SaveEditTask(task)" style="color: green;">✔</button>
                            <button @onclick="CancelEditTask" style="color: #e53935;">✖</button>
                        }
                        else
                        {
                            <button @onclick="() => StartEditTask(task)" style="color: #1976d2;">✎</button>
                            <button @onclick="() => DeleteTask(task)" style="background: transparent; border: none; color: #e53935; cursor: pointer;">&#10006;</button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="task-grid">
        @foreach (var task in tasks)
        {
            <div class="task-card">
                <div style="display: flex; align-items: center; margin-bottom: 8px;">
                    <input type="checkbox" checked="@task.IsCompleted" @onchange="@(() => ToggleComplete(task))" style="margin-right: 8px;" />
                    @if (editTask == task)
                    {
                        <input @bind="editTaskText" style="flex:1; margin-right:8px;" />
                    }
                    else
                    {
                        <span class="@GetTaskClass(task)" @onclick="@(() => ToggleComplete(task))" style="cursor: pointer; flex: 1;">@task.Text</span>
                    }
                    @if (editTask == task)
                    {
                        <button @onclick="() => SaveEditTask(task)" style="color: green;">✔</button>
                        <button @onclick="CancelEditTask" style="color: #e53935;">✖</button>
                    }
                    else
                    {
                        <button @onclick="() => StartEditTask(task)" style="color: #1976d2;">✎</button>
                        <button @onclick="() => DeleteTask(task)" style="background: transparent; border: none; color: #e53935; cursor: pointer; margin-left: 8px;">&#10006;</button>
                    }
                </div>
                <div style="font-size: 0.95em; color: #666; margin-bottom: 8px;">
                    @if (editTask == task)
                    {
                        <input type="date" @bind="editTaskDate" />
                    }
                    else
                    {
                        <span>Due: @task.DueDate.ToString("yyyy-MM-dd")</span>
                    }
                </div>
            </div>
        }
    </div>
}

@code {
    private string newTaskText = string.Empty;
    private DateTime newTaskDate = DateTime.Today;
    private List<TodoTask> tasks = new();
    private bool isGridView = false;

    // Edit state
    private TodoTask? editTask = null;
    private string editTaskText = string.Empty;
    private DateTime editTaskDate = DateTime.Today;

    protected override async Task OnInitializedAsync()
    {
        tasks = await Db.GetTodoTasks();
        tasks = tasks.OrderByDescending(t => t.DueDate).ToList();
    }

    private async Task AddTask()
    {
        if (!string.IsNullOrWhiteSpace(newTaskText))
        {
            var task = new TodoTask { Text = newTaskText, DueDate = newTaskDate, IsCompleted = false };
            await Db.SaveTodoTask(task);
            tasks.Add(task);
            newTaskText = string.Empty;
            newTaskDate = DateTime.Today;
        }
    }

    private async Task ToggleComplete(TodoTask task)
    {
        task.IsCompleted = !task.IsCompleted;
        await Db.SaveTodoTask(task);
    }

    private async Task ClearAllTasks()
    {
        await Db.DeleteAllTodoTasks();
        tasks.Clear();
    }

    private async Task DeleteTask(TodoTask task)
    {
        await Db.DeleteTodoTask(task);
        tasks.Remove(task);
    }

    private string GetTaskClass(TodoTask task) => task.IsCompleted ? "completed" : "";

    private void ToggleView()
    {
        isGridView = !isGridView;
    }

    // Edit Task Methods
    private void StartEditTask(TodoTask task)
    {
        editTask = task;
        editTaskText = task.Text;
        editTaskDate = task.DueDate;
    }

    private void CancelEditTask()
    {
        editTask = null;
    }

    private async Task SaveEditTask(TodoTask task)
    {
        if (editTask != null)
        {
            editTask.Text = editTaskText;
            editTask.DueDate = editTaskDate;
            await Db.UpdateTodoTask(editTask);
            editTask = null;
        }
    }
}