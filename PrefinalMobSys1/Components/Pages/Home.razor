@page "/"
@using PrefinalMobSys1.Data
@inject DatabaseContext Db

<h1>My Todo List</h1>

<div class="add-task" style="margin-bottom: 20px;">
    <input @bind="newTaskText" @bind:event="oninput" placeholder="Add a new task..." style="padding:8px; width: 60%;" />
    <input type="date" @bind="newTaskDate" style="padding:8px; margin-left: 10px;" />
    <button @onclick="AddTask" style="padding: 9px 16px; margin-left: 10px;">+</button>
</div>

<table class="task-table" style="width: 100%; border-collapse: collapse;">
    <thead style="background-color: var(--color-primary); color: var(--color-header-text);">
        <tr>
            <th style="padding: 10px; width: 60px;">Done</th>
            <th style="text-align: left; padding: 10px;">Task</th>
            <th style="text-align: left; padding: 10px; width: 150px;">Due Date</th>
            <th style="width: 50px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var task in tasks)
        {
            <tr style="border-bottom: 1px solid var(--color-border);">
                <td style="text-align: center; padding: 8px;">
                    <input type="checkbox" checked="@task.IsCompleted" @onchange="@(() => ToggleComplete(task))" />
                </td>
                <td style="padding: 8px;">
                    <label class="@GetTaskClass(task)" @onclick="@(() => ToggleComplete(task))" style="cursor: pointer;">@task.Text</label>
                </td>
                <td style="padding: 8px;">
                    @task.DueDate.ToString("yyyy-MM-dd")
                </td>
                <td style="text-align: center; padding: 8px;">
                    <button @onclick="@(() => RemoveTask(task))" title="Delete" style="background:none; border:none; color:red; cursor:pointer;">&#128465;</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private string newTaskText = string.Empty;
    private DateTime newTaskDate = DateTime.Today;
    private List<TodoTask> tasks = new();

    protected override async Task OnInitializedAsync()
    {
        tasks = await Db.GetTodoTasks();
        tasks = tasks.OrderByDescending(t => t.DueDate).ToList();
    }

    private async Task AddTask()
    {
        if (!string.IsNullOrWhiteSpace(newTaskText))
        {
            var task = new TodoTask { Text = newTaskText, DueDate = newTaskDate, IsCompleted = false };
            await Db.SaveTodoTask(task);
            tasks.Add(task);
            newTaskText = string.Empty;
            newTaskDate = DateTime.Today;
        }
    }

    private async Task ToggleComplete(TodoTask task)
    {
        task.IsCompleted = !task.IsCompleted;
        await Db.SaveTodoTask(task);
    }

    private async Task RemoveTask(TodoTask task)
    {
        await Db.DeleteTodoTask(task);
        tasks.Remove(task);
    }

    private string GetTaskClass(TodoTask task) => task.IsCompleted ? "completed" : "";
}