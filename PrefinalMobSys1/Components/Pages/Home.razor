@page "/"
@using PrefinalMobSys1.Components.Shared
@using PrefinalMobSys1.Data
@using PrefinalMobSys1.Models

<SectionContent SectionName="page-buttons">
	<div id="searchBox" class="input-group header-search" style="display:none;">
		<span class="input-group-text text-warning"><i class="fa fa-search"></i></span>
		<input id="txtSearch" type="text" class="form-control" placeholder="Search" value="@Model.Search" @onchange="SearchTerm" />
		<span class="input-group-text" onclick="hideSearchBox()"><i class="fa fa-times"></i></span>
	</div>
	<span id="controlBox">
		@* <CartButton /> *@
		<button class="btn text-secondary mr-2" onclick="showSearchBox()">
			<i class="fa fa-search"></i>
		</button>
	</span>    
</SectionContent>

@if (AppShell.IsUserLoggedIn)
{
	<h1 class="display-4 text-center mb-4">To-do List</h1>

	<div class="d-flex justify-content-between">
		<!-- toggle button for view mode -->
		<div class="btn-group" role="group" aria-label="View toggle">
			<input type="radio" class="btn-check" name="btnradio" id="btnradio1" autocomplete="off"
				   checked="@((CurrentView == TodoViewMode.Grid))"
				   @onchange="() => SetViewMode(TodoViewMode.Grid)">
			<label class="btn btn-outline-info" for="btnradio1">
				<i class="fa fa-th"></i> Grid View
			</label>
			<input type="radio" class="btn-check" name="btnradio" id="btnradio2" autocomplete="off"
				   checked="@((CurrentView == TodoViewMode.List))"
				   @onchange="() => SetViewMode(TodoViewMode.List)">
			<label class="btn btn-outline-secondary" for="btnradio2">
				<i class="fa fa-list"></i> List View
			</label>
		</div>
		<!-- add new todo button -->
		<div>
			<button class="btn btn-light" data-bs-toggle="modal" data-bs-target="#addTodoModal" autocomplete="off">
				<i class="fa fa-plus"></i>&nbsp;Add New Todo
			</button>
		</div>
	</div>

	<!-- add modal -->
	<div class="modal fade" id="addTodoModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content bg-light">
				<!-- modal header -->
				<div class="modal-header">
					<h1 class="modal-title">Add Todo</h1>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>

				<!-- modal body -->
				<div class="modal-body">
					<label>Add Todo Title:</label>
					<input type="text" id="todoTitle" class="form-control my-1" placeholder="To-do Title" @bind="NewTodoModel.Title" required />
					<label>Edit Todo Notes:</label>
					<textarea id="todoNotes" class="form-control my-2" placeholder="To-do Notes" @bind="NewTodoModel.Description" required></textarea>
					<label class="mt-2">Set Due Date:</label>
					<input type="date" id="todoDueDate" class="form-control my-2" @bind="NewTodoModel.DueDate" />
				</div>

				<!-- modal footer -->
				<div class="modal-footer">
					<button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancel</button>
					<button type="button" class="btn btn-success" @onclick="AddTodo">Add Todo</button>
				</div>
			</div>
		</div>
	</div>

	<!-- List View -->
	@if (CurrentView == TodoViewMode.List)
	{
		@foreach (var item in VisibleTodoItems)
		{
			<div @key="item.TodoID" class="card shadow-sm my-4">
				<div class="card-header bg-secondary text-white d-flex align-items-center justify-content-between px-3">
					<div>
						<input type="checkbox" class="form-check-input checkbox-btn me-2" checked="@item.IsCompleted" @onchange="@(() => ToggleCompletion(item))" />
						<span class="fw-bold lead text-wrap">@item.Title</span>
					</div>
					<div>
						<button class="btn btn-danger" @onclick="async ()=>{ await DeleteTodo(item); }">
							<i class="fa fa-trash"></i>
						</button>
					</div>
				</div>
				<div class="card-body">
					<p class="card-text text-wrap">@item.Description</p>
				</div>
				<div class="card-footer">
					<div class="d-flex justify-content-between p-1">
						<small class="text-muted">Due: @item.DueDate?.ToString("MMMM dd, yyyy")</small>
						<button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#editTodoModal" @onclick="()=>{ SetEditTodo(item); }">Edit</button>
					</div>
				</div>
			</div>
		}		
	}
	else if (CurrentView == TodoViewMode.Grid)
	{
		<!-- Grid View -->
		<div class="row my-4">
			@foreach (var item in VisibleTodoItems)
			{
				<div @key="item.TodoID" class="col-6 col-md-4 col-lg-3 mb-4">
					<div class="card shadow-sm h-100">
						<div class="card-header bg-info text-white d-flex align-items-center justify-content-between px-3">
							<div>
								<input type="checkbox" class="form-check-input checkbox-btn me-2" checked="@item.IsCompleted" @onchange="async () => { await ToggleCompletion(item); }" />
								<span class="fw-bold lead text-wrap">@item.Title</span>
							</div>
							<div>
								<button class="btn btn-danger" @onclick="async ()=>{ await DeleteTodo(item); }">
									<i class="fa fa-trash"></i>
								</button>
							</div>
						</div>
						<div class="card-body">
							<p class="card-text text-wrap">@item.Description</p>
						</div>
						<div class="card-footer">
							<div class="d-flex justify-content-between p-1">
								<small class="text-muted">Due: @item.DueDate?.ToString("MMMM dd, yyyy")</small>
								<button class="btn btn-warning" data-bs-toggle="modal" data-bs-target="#editTodoModal" @onclick="()=>{ SetEditTodo(item); }">Edit</button>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	}

	<!-- edit modal -->
	<div class="modal fade" id="editTodoModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content bg-info">
				<!-- modal header -->
				<div class="modal-header">
					<h1 class="modal-title">Edit Todo</h1>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>

				<!-- modal body -->
				<div class="modal-body">
					<label>Edit Todo Title:</label>
					<input type="text" id="editTodoTitle" class="form-control my-2" placeholder="Edit To-do Title" @bind="TodoModel.Title" required/>
					<label>Edit Todo Notes:</label>
					<textarea id="todoNotes" class="form-control my-2" placeholder="To-do Notes" @bind="TodoModel.Description" required></textarea>
					<label class="mt-2">Edit Due Date:</label>
					<input type="date" id="editTodoDueDate" class="form-control my-2" @bind="TodoModel.DueDate" />
				</div>

				<!-- modal footer -->
				<div class="modal-footer">
					<button type="button" class="btn btn-danger" data-bs-dismiss="modal">Cancel</button>
					<button type="button" class="btn btn-success" @onclick="async ()=> await UpdateTodo()">Save changes</button>
				</div>
			</div>
		</div>
	</div>
}
else
{
	<!-- Default homepage design for guests -->
	<div class="text-center mt-5">
		<h1 class="display-3">Welcome to the To-do App!</h1>
		<p class="lead">Please register or log in to access your to-do list and features.</p>
	</div>
}


<script src="js/jquery.cycle2.js"></script>
<script>
    function showSearchBox(){
        $('#searchBox').show();    
        $('#controlBox').hide();
    }

    function hideSearchBox(){
        $('#searchBox').hide();
        $('#controlBox').show();
    }

	function hideModal(modalId) {
		const modalEl = document.getElementById(modalId);
		const modalInstance = bootstrap.Modal.getInstance(modalEl);
		if (modalInstance) {
			modalInstance.hide();
		}
	}
</script>