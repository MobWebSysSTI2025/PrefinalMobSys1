@page "/recipeview"
<SectionContent SectionName="page-buttons">
    <span>
        <button class="btn text-warning" onclick="history.back()">
            <i class="fas fa-arrow-left"></i>
        </button>
        <button class="btn text-warning" >
            <i class="far fa-heart"></i>
        </button>
    </span>    
</SectionContent>
<div class="product-details">
    <h1>@Model.SelectedRecipe.Name</h1>
    <div class="product-photo">
        <img src="@Model.LoadedPhoto" />
    </div>
    <div class="product-middle-section">
        <div id="toCart" class="input-group">
            <span class="input-group-text btn-warning" @onclick="MinusServings"><i class="fa fa-minus"></i></span>
            <input id="txtQuantity" type="number" class="form-control" @bind="Model.Servings" />
            <span class="input-group-text btn-warning" @onclick="AddServings"><i class="fa fa-plus"></i></span>
        </div>
    </div>
    <div class="product-info">
        <div class="product-properties">
            <div class="product-property">
                <h3>Preparation Time</h3>
                <h2><i class="fa fa-clock-o"></i>@Model.SelectedRecipe.PrepTimeInMinutes</h2>
            </div>
            <div class="product-property">
                <h3>Cooking Time</h3>
                <h2><i class="fa fa-clock-o"></i>@Model.SelectedRecipe.CookTimeInMinutes</h2>
            </div>
        </div>
        <div class="product-description-review">
            <h3>Details</h3>
            <p>@Model.SelectedRecipe.Description</p>
        </div>
        <fieldset class="hasText">
            <legend>Ingredients:</legend>
            <div class="editable-list">
                <ul>
                    @foreach (var item in Model.Ingredients)
                    {
                        <li class="el-recipe-ingredient">
                            <span class="el-recipe-ingredient-amount">@item.Amount</span>
                            <span class="el-recipe-ingredient-unit">@item.Unit</span>
                            <span class="el-recipe-ingredient-name">@item.Name</span>
                        </li>
                    }
                </ul>
                <hr />
            </div>
        </fieldset>
        <fieldset class="hasText">
            <legend>Cooking Steps:</legend>
            <div>
                <ol>
                    @foreach (var item in Model.CookingSteps)
                    {
                        <li class="el-recipe-cooking-step">
                            <p>
                                @item.StepDetails
                            </p>
                        </li>
                    }
                </ol>
            </div>
        </fieldset>
    </div>
</div>