@page "/kanbanboard"

<div class="container py-4">
	<h1 class="mb-4 display-4">Kanban Board</h1>
	<div class="row">
		<!-- To Do Column -->
		<div class="col-md-4 my-2">
			<div class="card">
				<div class="card-header bg-primary text-white">
					Not Started
				</div>
				<ul class="list-group list-group-flush">
					<li class="list-group-item">
						<div class="bg-light text-white p-2">
							<span>Buy groceries</span>
						</div>
					</li>
					<li class="list-group-item">
						<div class="bg-light text-white p-2">
							<span>Buy toys</span>
						</div>
					</li>
					<li class="list-group-item">
						<div class="bg-light text-white p-2">
							<span>Buy clothes</span>
						</div>
					</li>
				</ul>
			</div>
		</div>
		<!-- In Progress Column -->
		<div class="col-md-4 my-2">
			<div class="card">
				<div class="card-header bg-secondary text-white">
					In Progress
				</div>
				<ul class="list-group list-group-flush">
					<li class="list-group-item">
						<div class="bg-light text-white p-2">
							<span>Buy groceries</span>
						</div>
					</li>
					<li class="list-group-item">
						<div class="bg-light text-white p-2">
							<span>Buy toys</span>
						</div>
					</li>
					<li class="list-group-item">
						<div class="bg-light text-white p-2">
							<span>Buy clothes</span>
						</div>
					</li>
				</ul>
			</div>
		</div>
		<!-- Done Column -->
		<div class="col-md-4 my-2">
			<div class="card">
				<div class="card-header bg-info text-white">
					Done
				</div>
				<ul class="list-group list-group-flush">
					<li class="list-group-item">
						<div class="bg-light text-white p-2">
							<span>Buy groceries</span>
						</div>
					</li>
					<li class="list-group-item">
						<div class="bg-light text-white p-2">
							<span>Buy toys</span>
						</div>
					</li>
					<li class="list-group-item">
						<div class="bg-light text-white p-2">
							<span>Buy clothes</span>
						</div>
					</li>
				</ul>
			</div>
		</div>
	</div>
</div>
